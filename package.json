{
  "name": "trivia-tavern",
  "version": "83.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build-cloud.mjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.cjs",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:cloud-browser": "node server/tests/browser-live.cjs && node server/tests/browser-apk-code.cjs"
  },
  "devDependencies": {
    "wrangler": "4.161.0"
  }
}
