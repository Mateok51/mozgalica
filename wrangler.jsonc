{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trivia-tavern",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "RoomDirectory" },
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDirectory", "GameRoom"] }
  ],
  "observability": { "enabled": false }
}
